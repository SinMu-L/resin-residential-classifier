# 代理节点住宅/机房识别服务 —— 配置样例
# 复制为 .env 后按需修改

# —— Docker 部署：宿主机目录挂载（仅 docker compose 用） ——
# 这三个是【宿主机】目录；容器内固定挂到 /data/source、/data/app、/data/mmdb。
RESIN_CACHE_HOST_DIR=./resin-data/cache
# 例（Resin 数据在别处）：RESIN_CACHE_HOST_DIR=/root/Resin/data/cache
APP_DB_HOST_DIR=./app-data
MMDB_HOST_DIR=./mmdb-data

# —— 数据/应用库路径：以下是【容器内】路径，不要填宿主机路径 ——
SOURCE_DB_PATH=/data/source/cache.db
APP_DB_PATH=/data/app/nodes.sqlite
# （离线库路径 MERGED_IP_DB_PATH 见下方“离线 ASN 库”一节）

# 节点准入过滤（入库前）：
# 抽取的节点类型：all/*/空=全部；或逗号分隔白名单（如 http,vless,trojan）
SOURCE_INCLUDE_TYPES=all
# 要求 Resin 原生健康（未熔断 + 有出口 IP + 有延迟样本）
SOURCE_REQUIRE_HEALTHY=true
# 延迟上限（毫秒），<=0 关闭延迟门槛
SOURCE_MAX_LATENCY_MS=300

# 启用的富化器（逗号分隔，按顺序构成回退链）
# mergedip=离线 ASN 库；ipinfo=在线富化。例：ENRICHERS=mergedip,ipinfo
ENRICHERS=mergedip,ipinfo

# 离线 ASN 库路径（NetworkCats/Merged-IP-Data 的 Merged-IP.mmdb）
# Docker（compose）已将其指向可写卷 /data/mmdb/Merged-IP.mmdb；
# 本地运行可改为 ./resin-data/cache/Merged-IP.mmdb 等
MERGED_IP_DB_PATH=/data/mmdb/Merged-IP.mmdb
# 自动下载离线库（启动时由 entrypoint 下载；默认开启，无需离线库时设为 false）
MERGED_IP_AUTO_DOWNLOAD=true
# 下载源（可按需换成镜像/代理地址）
MERGED_IP_DOWNLOAD_URL=https://github.com/NetworkCats/Merged-IP-Data/releases/latest/download/Merged-IP.mmdb
# 强制重新下载（忽略已存在文件）/ 单次下载超时（秒）
MERGED_IP_DOWNLOAD_FORCE=false
MERGED_IP_DOWNLOAD_TIMEOUT=300
# 运行期刷新间隔（秒），0=仅启动时检查一次
MERGED_IP_DOWNLOAD_INTERVAL=0

# 启动时自动导入内置 ASN 名单（L1 初筛，幂等 upsert；约 70 云 + 110 住宅 ISP）
# Docker compose 部署默认自动执行；本地开发可手动跑 scripts/seed_asn_registry.py
ASN_SEED_ON_START=true

# IP 富化缓存有效期（秒），避免重复调用与限流
ENRICH_CACHE_TTL=86400

# ipinfo.io API Token（启用 ipinfo 时必填）
IPINFO_TOKEN=
# ipinfo API 基址（新统一端点；旧端点作为回退）
IPINFO_BASE_URL=https://api.ipinfo.io
# 单次 /batch 批量富化的 IP 数
IPINFO_BATCH_SIZE=100

# 自动同步间隔（秒），0 = 关闭
INGEST_INTERVAL=300

# REST API 监听
API_HOST=0.0.0.0
API_PORT=8000

# POST /refresh 鉴权（留空=不鉴权）
REFRESH_TOKEN=

# /nodes/random?avoid_recent 环形缓冲参数
RECENT_TTL=60
RECENT_MAXLEN=1000

# -- 高质量节点池（L1 ASN 初筛 / L2 AbuseIPDB / L4 复检淘汰） ---------------- #
# 启用池漏斗定时调度（手动 POST /pool/rebuild 不受此项影响）
POOL_ENABLED=true
# 池复检周期（秒），0 = 关闭定时调度
POOL_INTERVAL=86400
# L1：先按富化 is_hosting 判定机房（命中直接拒）；未知 ASN 是否直接拒绝（严格白名单）
POOL_L1_STRICT=true

# L2：AbuseIPDB（https://www.abuseipdb.com）API Key
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
# 单次请求超时（秒）/ 并发查询数
ABUSEIPDB_TIMEOUT=8
ABUSEIPDB_CONCURRENCY=8
# abuseConfidenceScore < 该值即放行
POOL_ABUSE_MAX_SCORE=30
# 风险查询缓存 TTL（秒）/ 统计举报所覆盖的天数
ABUSE_CACHE_TTL=86400
ABUSE_MAX_AGE_DAYS=90

# L4：连续失败多少次淘汰 / 各状态复检间隔与冷却
POOL_EVICT_FAILURES=2
POOL_RECHECK_IN_POOL=604800
POOL_RECHECK_PROBATION=86400
POOL_COOLDOWN=604800

# -- Resin 订阅发布（只读：Resin 主动拉取，本服务不写 Resin） ----------------- #
# 启用 GET /resin/subscription 订阅端点，供 Resin 作为「远程订阅」拉取
RESIN_FEED_ENABLED=false
# 访问订阅端点的 token（公网暴露时必填；留空=不鉴权，仅限内网）
RESIN_FEED_TOKEN=
# 纳入订阅的池状态（逗号分隔），默认仅 in_pool
RESIN_FEED_STATES=in_pool
# 建议在 Resin 中使用的订阅名（仅用于文档/状态展示）
RESIN_FEED_SUBSCRIPTION_NAME=resin-residential-pool
